# Telegram bot that receives contact-form messages (server-side only; never prefix with NEXT_PUBLIC_).
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Your personal chat id (the bot can only message you after you send it /start)
TELEGRAM_CHAT_ID=

# Optional: canonical site URL used for metadata, sitemap, robots and JSON-LD.
# Defaults to https://htetaunglinn.vercel.app
# NEXT_PUBLIC_SITE_URL=

# Optional: durable contact-form rate limits shared by all serverless instances (Upstash Redis REST).
# Without them the limits are kept in memory per instance. Vercel KV's KV_REST_API_URL/KV_REST_API_TOKEN also work.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
